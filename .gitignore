bin

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

integration_tests/recording/*

main

# Build artifacts
*.mcpb
mcpb/server/

# Claude Code settings
.claude/settings.json

# Local scratch/working directory — never commit.
# Has previously held clones of other (private) repos; committing it would
# publish unrelated internal source.
temp/

# Local credentials and environment overrides
.env
.env.*
*.pem
*.key

# The CLI's own local config + encrypted token cache. If a contributor runs the
# CLI from inside the repo, this must never be committable.
# .wso2 is current (CLI_HOME_DIR); .choreo is the pre-rebrand path.
.wso2/
.choreo/

# In-tree build outputs. `make build` targets bin/ (ignored above), but a bare
# `go build` drops the binary at the repo root.
/wso2-integration-platform
/wso2-integration-platform.exe
/choreo
/choreo.exe
*.exe

# Test and coverage output
coverage.out
coverage.html
*.test

# OS / editor / node cruft
.DS_Store
Thumbs.db
node_modules/
dist/

# Editor-local VS Code files. Uses `.vscode/*` rather than `.vscode/` on purpose:
# git will not descend into an excluded directory, so a negation inside one is
# never reached. The two configs below are shared and stay tracked — mcp.json is
# the example README.md points at.
.vscode/*
!.vscode/launch.json
!.vscode/mcp.json
