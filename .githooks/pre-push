# Runs the static checks CI's Static Checks job runs, before anything is pushed:
# gofmt over each module's tracked Go files, then `make vet lint`. A failure
# here is one CI would report minutes later, on a pull request.
#
# Enable it once per clone with `make hooks`. It checks the working tree, not
# the commits being pushed, so uncommitted edits count. `git push --no-verify`
# skips it.

set -eu

cd "$(git rev-parse --show-toplevel)"

failed=0

# check_gofmt <label> <pathspec>... lists the tracked files gofmt would change.
# The file selection mirrors .github/workflows/pr-checks.yml.
check_gofmt() {
	label=$1
	shift
	unformatted=$(git ls-files -z -- "$@" | xargs -0 gofmt -l)
	if [ -n "$unformatted" ]; then
		echo "pre-push: the following $label files require gofmt:" >&2
		echo "$unformatted" | sed 's/^/  /' >&2
		failed=1
	fi
}

check_gofmt shell '*.go' ':!sdk/**' ':!modules/example/**'
check_gofmt SDK 'sdk/*.go'
check_gofmt example-module 'modules/example/*.go'

if [ "$failed" -ne 0 ]; then
	echo "pre-push: run gofmt -w on the files above, then push again." >&2
	exit 1
fi

if ! make vet lint; then
	echo "pre-push: make vet lint failed; fix the findings above, then push again." >&2
	exit 1
fi
